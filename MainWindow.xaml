<Window x:Class="CDir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CDir.Controls"
        Title="C-Dir"
        Width="1300"
        Height="820"
        MinWidth="780"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== top bar ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="C" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="C-Dir" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="다중 창 파일 관리자 · Everything 연동" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Margin="18,0" VerticalAlignment="Center"
                        Background="{DynamicResource PanelAltBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid x:Name="SearchArea">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource SubTextBrush}" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,5"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnSearchKeyDown" />

                            <TextBlock Text="전체 드라이브 즉시 검색   (F3)"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource SubTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2"
                                Content="&#xE711;"
                                Style="{StaticResource IconButton}"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip="지우기 (Esc)"
                                Click="OnClearSearch" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="ProviderChip" Text="내장 인덱스" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </Border>

                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Layout1" Style="{StaticResource SegmentButton}" Content="1" Tag="1" GroupName="Layout" Checked="OnLayoutChecked" />
                            <RadioButton x:Name="Layout2" Style="{StaticResource SegmentButton}" Content="2" Tag="2" GroupName="Layout" Checked="OnLayoutChecked" />
                            <RadioButton x:Name="Layout3" Style="{StaticResource SegmentButton}" Content="3" Tag="3" GroupName="Layout" Checked="OnLayoutChecked" />
                            <RadioButton x:Name="Layout4" Style="{StaticResource SegmentButton}" Content="4" Tag="4" GroupName="Layout" Checked="OnLayoutChecked" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ThemeButton" Content="&#xE706;" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                            ToolTip="라이트 / 다크 테마" Click="OnToggleTheme" />
                    <Button x:Name="AppMenuButton" Content="&#xE712;" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                            ToolTip="앱 메뉴" Click="OnAppMenu" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== panes ===== -->
        <Grid x:Name="PaneHost" Grid.Row="1" Margin="8">
            <controls:FilePane x:Name="Pane0" Margin="5" />
            <controls:FilePane x:Name="Pane1" Margin="5" />
            <controls:FilePane x:Name="Pane2" Margin="5" Visibility="Collapsed" />
            <controls:FilePane x:Name="Pane3" Margin="5" Visibility="Collapsed" />
        </Grid>

        <!-- ===== search results overlay ===== -->
        <Border x:Name="ResultsPanel"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                Height="330"
                Margin="8"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,8,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="검색" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding StatusText}" Margin="10,1,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Enter 열기 · Ctrl+Enter 폴더에서 보기 · Esc 닫기"
                               FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="폴더에서 보기" Style="{StaticResource ToolButton}" Padding="10,3" FontSize="11.5"
                                Click="OnRevealSearchResult" />
                        <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="26" Height="26"
                                Click="OnClearSearch" ToolTip="닫기 (Esc)" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView x:Name="SearchList"
                              Margin="6,0,6,6"
                              ItemsSource="{Binding Results}"
                              SelectionMode="Extended"
                              MouseDoubleClick="OnSearchResultDoubleClick"
                              KeyDown="OnSearchListKeyDown"
                              PreviewMouseRightButtonDown="OnSearchResultRightClick">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="이름" Width="270">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="위치" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FolderText}" Foreground="{DynamicResource SubTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="크기" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="수정한 날짜" Width="125">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource SubTextBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="열기" Click="OnOpenSearchResult" />
                                <MenuItem Header="폴더에서 보기" Click="OnRevealSearchResult" />
                                <MenuItem Header="경로 복사" Click="OnCopySearchPath" />
                                <MenuItem Header="속성" Click="OnSearchResultProperties" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <TextBlock Text="검색 결과가 없습니다."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubTextBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== status bar ===== -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusPath" Text="" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                    <TextBlock x:Name="StatusSelection" Text="" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="IndexStatusText" Text="" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="CancelIndexButton" Content="중지" Style="{StaticResource ToolButton}" Padding="8,2"
                            FontSize="11" Click="OnCancelIndex" Visibility="Collapsed" />
                    <Button Content="인덱스 재생성" Style="{StaticResource ToolButton}" Padding="8,2" FontSize="11"
                            Click="OnReindex" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
